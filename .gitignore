# Dependencies
node_modules/

# Build output
dist/
frontend/dist/
backend/dist/

# EZUIKit decoder assets, copied from node_modules by postinstall (see
# frontend/scripts/copy-ezuikit-static.mjs) so the live-view player doesn't
# depend on EZVIZ's remote CDN.
frontend/public/ezuikit_static/

# Env files (never commit secrets)
.env
.env.local
backend/.env
frontend/.env

# Uploaded QR images (runtime data, not source)
backend/storage/qr/*
!backend/storage/qr/.gitkeep

# Logs
*.log
npm-debug.log*

# Editor/OS
.DS_Store
.vscode/
.idea/

# Prisma
backend/prisma/*.db

# TypeScript build cache
*.tsbuildinfo
